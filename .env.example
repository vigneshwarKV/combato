# Managed LLM provider config (server-side only — never bundled into the client).
# Copy to `.env` and fill in. Without a key, the game falls back to random moves.

# Which provider the /api/moves proxy uses. 'deepseek-flash' (default, cheapest) | 'openai-mini'
AI_PROVIDER=deepseek-flash

# Provider keys. Only the one matching AI_PROVIDER is required.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Absolute base URL of the deployed AI proxy, bundled into the CLIENT (VITE_
# prefix = public). Leave EMPTY for web/PWA builds (same-origin relative call).
# REQUIRED for native iOS/Android builds — the app has no local server, so it
# must call your deployed backend, e.g. https://prompt-kombat.vercel.app
# (no trailing slash, no /api/moves suffix — that's added automatically).
VITE_API_BASE=

# ── Supabase (auth + leaderboard) ─────────────────────────────────────────────
# CLIENT (public, shipped to the app). This is a Vite app, so client env vars
# MUST start with VITE_ — the Vercel Supabase integration's NEXT_PUBLIC_* /
# COMBATO_* names are invisible to the client. Add these two manually, copying
# the values from the integration vars noted in parentheses.
VITE_SUPABASE_URL=            # value of COMBATO_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=       # value of NEXT_PUBLIC_COMBATO_SUPABASE_ANON_KEY

# ── Native Google sign-in (Android/iOS) ───────────────────────────────────────
# OAuth 2.0 *Web* client ID from Google Cloud (…apps.googleusercontent.com).
# Required for the NATIVE build's Google sign-in (Capacitor uses the platform
# account picker + ID-token exchange, not the web redirect). It's the audience
# Supabase verifies, so it must match the Google provider's client in Supabase.
# NOT a secret (client IDs are public); leave empty for web-only builds.
# A separate Android OAuth client (package com.combato.game + release SHA-1) must
# also exist in Google Cloud for the picker to work, but its ID is NOT set here.
VITE_GOOGLE_WEB_CLIENT_ID=

# SERVER (used by /api functions — NEVER prefix with VITE_, never commit real
# values). Provided automatically by the Vercel Supabase integration; the code
# reads these (falling back to plain SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY):
#   COMBATO_SUPABASE_URL               — project URL
#   COMBATO_SUPABASE_SERVICE_ROLE_KEY  — admin key, bypasses RLS (used by /api/score)
#
# Also added by the integration but NOT used by this app (safe to leave/ignore):
#   COMBATO_POSTGRES_*                 — raw DB conn strings (we use supabase-js)
#   COMBATO_SUPABASE_PUBLISHABLE_KEY   — newer public key (we use the anon key)
#   COMBATO_SUPABASE_SECRET_KEY        — newer server key (we use service_role)
#   COMBATO_SUPABASE_JWT_SECRET        — not needed (tokens verified via getUser())
