# Managed LLM provider config (server-side only — never bundled into the client).
# Copy to `.env` and fill in. Without a key, the game falls back to random moves.

# Which provider the /api/ai proxy uses. 'deepseek-flash' (default, cheapest) | 'openai-mini'
AI_PROVIDER=deepseek-flash

# Provider keys. Only the one matching AI_PROVIDER is required.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Absolute base URL of the deployed AI proxy, bundled into the CLIENT (VITE_
# prefix = public). Leave EMPTY for web/PWA builds (same-origin relative call).
# REQUIRED for native iOS/Android builds — the app has no local server, so it
# must call your deployed backend, e.g. https://prompt-kombat.vercel.app
# (no trailing slash, no /api/ai suffix — that's added automatically).
VITE_API_BASE=
